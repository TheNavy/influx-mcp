# Copy this file to .env and fill in your values. Never commit .env.

# --- InfluxDB (required) ---
# Base URL of your InfluxDB 2.x instance.
INFLUXDB_URL=http://influxdb:8086
# API token. Use a token that can only read (see README, "Security").
INFLUXDB_TOKEN=YOUR_READ_ONLY_TOKEN
# Organization name or ID.
INFLUXDB_ORG=YOUR_ORG

# --- MCP server (optional) ---
# If set, clients must send "Authorization: Bearer <value>".
MCP_AUTH_TOKEN=
# Upper limit for the number of rows one query may return.
MCP_MAX_ROWS=1000
# Seconds to wait for InfluxDB before giving up.
INFLUXDB_TIMEOUT=30
# Browser origins allowed to call the server, comma separated. Leave empty
# unless you use a browser-based MCP client.
MCP_ALLOWED_ORIGINS=
